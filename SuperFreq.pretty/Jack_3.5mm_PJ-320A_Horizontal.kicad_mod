(footprint "Jack_3.5mm_PJ-320A_Horizontal"
	(version 20241229)
	(generator "claude")
	(layer "F.Cu")
	(descr "3.5 mm 4-pole jack PJ-320A (Tayda A-4863), horizontal, through-hole. From Tayda's drawing: pins 2/3/4 in one row 3.2/6.2/10.2 mm behind the body front, pin 5 in the opposite row at 11.3 mm, rows 4.6 mm apart, flat 1.2x0.6 pins; 2x 1.5 mm pegs 7 mm apart; body 6.1 x 12.1 x 5 mm + 2 mm collar. Pads: T = pin 4 (tip), R = pin 3 (ring 1), S = pins 2 + 5 (ring 2 + sleeve, both touch a 3-pole plug's sleeve). Origin = barrel axis at the collar front; opening faces -Y")
	(tags "audio jack 3.5mm PJ-320A PJ320A TRRS headphone Tayda A-4863")
